Cell[StyleData["AssistantIconTabbed"],
 TemplateBoxOptions->{
 DisplayFunction->(
  DynamicModuleBox[{
   Typeset`dingbatCell$$ = None, Typeset`targetCell$$ = None, 
    Typeset`display$$ = Dynamic[
      RawBoxes[
       FEPrivate`FrontEndResource[
       "ChatbookExpressions", "ChatOutputCellDingbat"]]]}, 
   DynamicWrapperBox[
    DynamicBox[
     ToBoxes[Typeset`display$$, StandardForm]], 
    Catch[
     If[
      Not[Wolfram`Chatbook`Common`$cloudNotebooks], 
      With[{
       Wolfram`Chatbook`UI`Private`tagRules$ = 
        CurrentValue[Typeset`targetCell$$, TaggingRules]}, Typeset`display$$ = 
       Which[
         FailureQ[Wolfram`Chatbook`UI`Private`tagRules$], 
         Wolfram`Chatbook`Common`chatbookIcon["ChatOutputCellDingbat", False], 
         KeyExistsQ[Wolfram`Chatbook`UI`Private`tagRules$, "PageData"], 
         Wolfram`Chatbook`UI`Private`makeChatOutputPagedDingbat[
         Typeset`targetCell$$, Typeset`dingbatCell$$, 
          Lookup[Wolfram`Chatbook`UI`Private`tagRules$, "PageData", <||>]], 
         KeyExistsQ[Wolfram`Chatbook`UI`Private`tagRules$, "ChatData"], 
         Wolfram`Chatbook`UI`Private`makeChatOutputDingbat[
          Lookup[
          Wolfram`Chatbook`UI`Private`tagRules$, "ChatData", <||>, 
           BinaryDeserialize[
            BaseDecode[#]]& ]], True, 
         Wolfram`Chatbook`Common`chatbookIcon[
         "ChatOutputCellDingbat", False]]]], 
     Blank[]], SynchronousUpdating -> False, TrackedSymbols :> {}], 
   Initialization :> (
    If[Wolfram`Chatbook`Common`$cloudNotebooks, Typeset`targetCell$$ = 
      EvaluationCell[], Typeset`dingbatCell$$ = EvaluationCell[]; 
      Typeset`targetCell$$ = ParentCell[Typeset`dingbatCell$$]]; 
    Needs["Wolfram`Chatbook`" -> None]; Null), DynamicModuleValues :> {}, 
   UnsavedVariables :> {
    Typeset`dingbatCell$$, 
     Typeset`targetCell$$}]& \
)},ExpressionUUID->"6888e07a-d21e-664b-bdee-9f2acaebcf7d"],

