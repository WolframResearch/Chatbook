{
    "description": "Streams a thought and two message chunks, reports usage, then ends the turn (end_turn).",
    "steps": [
        {"type": "notify", "update": {"sessionUpdate": "agent_thought_chunk", "content": {"type": "text", "text": "Thinking about it. "}}},
        {"type": "notify", "update": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "Hello "}}},
        {"type": "notify", "update": {"sessionUpdate": "agent_message_chunk", "content": {"type": "text", "text": "world."}}},
        {"type": "notify", "update": {"sessionUpdate": "usage_update", "size": 200000, "used": 1234, "cost": {"amount": 0.01, "currency": "USD"}}},
        {"type": "respond", "stopReason": "end_turn"}
    ]
}
