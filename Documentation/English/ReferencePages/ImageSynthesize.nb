  RowBox[{"ImageSynthesize", "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "abc236e7-f84b-41b5-be77-f41bf3b8ac61"],
 "\[LineSeparator]generates ",
