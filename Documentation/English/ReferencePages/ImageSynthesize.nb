Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ec961d08-cd49-4a5a-a8a5-534cdb677031"],
 Cell[BoxData[
  RowBox[{"ImageSynthesize", "[", 
   StyleBox["text", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "aea81f8b-bd4f-4265-8443-d6ba84ac1b27"],
